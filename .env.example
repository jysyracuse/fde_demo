# Salesforce External Client App (client credentials flow) — see docs/SETUP.md
SF_DOMAIN=yourname-dev-ed.develop.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Optional: pin an API version, otherwise the latest the org offers is used
SF_API_VERSION=

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_CHANNEL_ID=
# Who takes over internal actions lives in data/org.db: `uv run python scripts/roles.py`

# LLM (layers 2-3; models per task in arfollow/llm.py)
DEEPSEEK_API_KEY=
# Optional: only scripts/eval_actions.py (the Jev eval arm)
TYPESAFE_API_KEY=
